# 复制为 backend/.env 后修改；不要提交真实密钥
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=root123456
DB_NAME=learning
WRITE_DB_PORT=3306
READ_DB_PORT=3307
DB_POOL_SIZE=8

# mock：无需 API Key，使用确定性模板，适合离线演示 / 答辩
# claude：真实调用 Anthropic，失败会自动重试并降级 mock
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=8192
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
